{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Tool Contract",
  "type":"object",
  "required":["contract_version","tools"],
  "properties":{
    "contract_version":{"type":"integer","const":1},
    "schema":{"type":"string"},
    "tools":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["id","type","requirement","purpose"],
      "properties":{
        "id":{"type":"string"},
        "type":{"enum":["runtime_capability","script","reference","mcp","api_action"]},
        "requirement":{"type":"string"},
        "purpose":{"type":"string"},
        "script":{"type":"string"},
        "path":{"type":"string"},
        "deterministic":{"type":"boolean"},
        "mutates_workspace":{"type":"boolean"},
        "runtime_fallback":{"type":"string"}
      },
      "additionalProperties":false
    }}
  },
  "additionalProperties":false
}